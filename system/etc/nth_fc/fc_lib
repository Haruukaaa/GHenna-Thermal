#!/system/bin/sh
# Fast Charge - Universal for all SOCs
# Supports Qualcomm, MediaTek, Samsung, and others

Write() {
    local value="$1"
    local path="$2"
    
    if [ -f "$path" ] 2>/dev/null; then
        chmod 0755 "$path" 2>/dev/null
        echo "$value" > "$path" 2>/dev/null
    fi
}

# Detect SOC type
detect_soc() {
    local soc=$(getprop ro.soc.manufacturer 2>/dev/null)
    if [ -z "$soc" ]; then
        soc=$(getprop ro.board.platform 2>/dev/null)
    fi
    echo "$soc"
}

# Dynamic path finding for various power supply nodes
find_power_supply_paths() {
    local param="$1"
    find /sys/class/power_supply -name "$param" 2>/dev/null
}

# Make all power supply paths writable (universal)
enable_power_supply_write() {
    find /sys/class/power_supply -type f -name "current_max" 2>/dev/null | while read -r path; do
        chmod 0755 "$(dirname "$path")" 2>/dev/null
    done
    
    # Try Qualcomm-specific paths if they exist
    chmod 0755 /sys/module/qpnp_smbcharger/*/*  2>/dev/null
    chmod 0755 /sys/module/dwc3_msm/*/*         2>/dev/null
    chmod 0755 /sys/module/phy_msm_usb/*/*      2>/dev/null
}

# Apply charge values to all available paths
apply_charge_current() {
    local value="$1"
    local paths=(
        "usb/current_max"
        "usb/hw_current_max"
        "usb/pd_current_max"
        "usb/ctm_current_max"
        "usb/sdp_current_max"
        "usb/constant_charge_current"
        "usb/constant_charge_current_max"
        "main/current_max"
        "main/constant_charge_current"
        "main/constant_charge_current_max"
        "dc/current_max"
        "dc/constant_charge_current_max"
        "parallel/current_max"
        "parallel/constant_charge_current_max"
        "battery/current_max"
        "battery/input_current_max"
        "battery/constant_charge_current"
        "battery/constant_charge_current_max"
        "bms/constant_charge_current_max"
        "pc_port/current_max"
        "qpnp-dc/current_max"
        "wireless/constant_charge_current_max"
    )
    
    for path_suffix in "${paths[@]}"; do
        for full_path in $(find /sys/class/power_supply -path "*/$path_suffix" 2>/dev/null); do
            Write "$value" "$full_path"
        done
    done
}

FCS5500() {
    local CURRENT="5500000"
    local WIRELESS_LEVEL="3500"
    local MODULE_CURRENT="5000"
    local TEMP_COOL="150"
    local TEMP_HOT="480"
    
    SOC=$(detect_soc)
    enable_power_supply_write
    
    while true; do
        # Qualcomm-specific settings (fail-safe if not present)
        Write '1' /sys/kernel/fast_charge/force_fast_charge
        Write '1' /sys/kernel/fast_charge/failsafe
        Write "$WIRELESS_LEVEL" /sys/kernel/fast_charge/wireless_charge_level
        
        # Universal battery settings
        Write '1' /sys/class/power_supply/battery/allow_hvdcp3
        Write '0' /sys/class/power_supply/battery/restricted_charging
        Write '0' /sys/class/power_supply/battery/system_temp_level
        Write '0' /sys/class/power_supply/battery/input_current_limited
        Write '1' /sys/class/power_supply/battery/subsystem/usb/pd_allowed
        Write '1' /sys/class/power_supply/battery/input_current_settled
        
        # USB settings
        Write '1' /sys/class/power_supply/usb/pd_allowed
        Write '1' /sys/class/power_supply/usb/boost_current
        
        # Wireless settings (if available)
        Write '1' /sys/class/power_supply/wireless/input_current_settled
        
        # Qualcomm battery restrictions
        Write '0' /sys/class/qcom-battery/restricted_charging
        Write "$CURRENT" /sys/class/qcom-battery/restricted_current
        
        # Skip thermal (Qualcomm)
        Write '0' /sys/module/smb_lib/parameters/skip_thermal
        
        # Temperature settings (find dynamically)
        for bms_path in $(find /sys/class/power_supply -name "bms" -o -name "fg" 2>/dev/null); do
            [ -d "$bms_path" ] && {
                Write "$TEMP_COOL" "$bms_path/temp_cool"
                Write "$TEMP_HOT" "$bms_path/temp_warm"
                Write "$TEMP_HOT" "$bms_path/temp_hot"
            }
        done
        
        # Apply charge current to all available paths
        apply_charge_current "$CURRENT"
        
        # Qualcomm module parameters (if available)
        Write "$MODULE_CURRENT" /sys/module/qpnp_smbcharger/parameters/default_hvdcp_icl_ma
        Write "$MODULE_CURRENT" /sys/module/qpnp_smbcharger/parameters/default_dcp_icl_ma
        Write "$MODULE_CURRENT" /sys/module/qpnp_smbcharger/parameters/default_hvdcp3_icl_ma
        Write "$MODULE_CURRENT" /sys/module/dwc3_msm/parameters/dcp_max_current
        Write "$MODULE_CURRENT" /sys/module/dwc3_msm/parameters/hvdcp_max_current
        Write "$MODULE_CURRENT" /sys/module/phy_msm_usb/parameters/dcp_max_current
        Write "$MODULE_CURRENT" /sys/module/phy_msm_usb/parameters/hvdcp_max_current
        Write "$MODULE_CURRENT" /sys/module/phy_msm_usb/parameters/lpm_disconnect_thresh
        
        sleep 1
    done
}


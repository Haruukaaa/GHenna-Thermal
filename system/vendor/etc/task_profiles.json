{
  "Attributes": [
    { "Name": "CPUForeground", "Controller": "cpu", "File": "foreground/cpus" },
    { "Name": "CPUBackground", "Controller": "cpu", "File": "background/cpus" },
    { "Name": "CPUTopApp", "Controller": "cpu", "File": "top-app/cpus" },
    { "Name": "CPUAudio", "Controller": "cpu", "File": "audio-app/cpus" },

    { "Name": "MemStats", "Controller": "memory", "File": "memory.stat" },
    { "Name": "MemLimit", "Controller": "memory", "File": "memory.limit_in_bytes", "FileV2": "memory.max" },
    { "Name": "MemSoftLimit", "Controller": "memory", "File": "memory.soft_limit_in_bytes", "FileV2": "memory.low" },
    { "Name": "MemSwappiness", "Controller": "memory", "File": "memory.swappiness" },
    { "Name": "MemUsage", "Controller": "memory", "File": "memory.usage_in_bytes" },

    { "Name": "UClampMin", "Controller": "cpu", "File": "cpu.uclamp.min" },
    { "Name": "UClampMax", "Controller": "cpu", "File": "cpu.uclamp.max" },
    { "Name": "UClampLatencySensitive", "Controller": "cpu", "File": "cpu.uclamp.latency_sensitive" },

    { "Name": "FreezerState", "Controller": "freezer", "File": "cgroup.freeze" }
  ],

  "Profiles": [
    {
      "Name": "Perf.High",
      "Actions": [
        { "Name": "JoinCgroup", "Params": { "Controller": "cpu", "Path": "foreground" } },
        { "Name": "SetAttribute", "Params": { "Name": "UClampLatencySensitive", "Value": "1" } },
        { "Name": "LogAction", "Params": { "Message": "High performance mode activated" } }
      ]
    },
    {
      "Name": "Perf.Max",
      "Actions": [
        { "Name": "JoinCgroup", "Params": { "Controller": "cpu", "Path": "top-app" } },
        { "Name": "SetAttribute", "Params": { "Name": "UClampLatencySensitive", "Value": "1" } },
        { "Name": "LogAction", "Params": { "Message": "Max performance mode activated" } }
      ]
    },
    {
      "Name": "Mem.Low",
      "Actions": [
        { "Name": "SetAttribute", "Params": { "Name": "MemSoftLimit", "Value": "16MB" } },
        { "Name": "SetAttribute", "Params": { "Name": "MemSwappiness", "Value": "150" } },
        { "Name": "LogAction", "Params": { "Message": "Low memory tier applied" } }
      ]
    },
    {
      "Name": "Mem.High",
      "Actions": [
        { "Name": "SetAttribute", "Params": { "Name": "MemSoftLimit", "Value": "512MB" } },
        { "Name": "SetAttribute", "Params": { "Name": "MemSwappiness", "Value": "100" } },
        { "Name": "LogAction", "Params": { "Message": "High memory tier applied" } }
      ]
    },
    {
      "Name": "ResetDefaults",
      "Actions": [
        { "Name": "JoinCgroup", "Params": { "Controller": "cpu", "Path": "" } },
        { "Name": "SetAttribute", "Params": { "Name": "MemSwappiness", "Value": "100" } },
        { "Name": "LogAction", "Params": { "Message": "System reset to defaults" } }
      ]
    }
  ],

  "AggregateProfiles": [
    {
      "Name": "Category.Performance",
      "Profiles": [ "Perf.High", "Mem.High" ]
    },
    {
      "Name": "Category.EnergySaving",
      "Profiles": [ "Mem.Low" ]
    },
    {
      "Name": "Category.Reset",
      "Profiles": [ "ResetDefaults" ]
    }
  ]
}

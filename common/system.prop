# QuickPower
ro.config.hw_quickpoweron=true

#fps
ro.vendor.dfps.enable=false

# GPU Turbo Boost system properties
debug.gpu.renderscript.load_store_texture=1
debug.enabletr=true
debug.gr.numframebuffers=5
debug.egl.buffcount=5
debug.hwui.level=0
debug.overlayui.enable=1
debug.performance.tuning=1
hw3d.force=1
persist.sys.ui.hw=1
persist.service.gfx.gpu_rendering_priority=1
ro.config.enable.hw_accel=true
ro.fb.mode=1
video.accelerate.hw=1

# HWUI
debug.hwui.app_memory_policy=aggresive
debug.hwui.optimized_texture_upload=true
debug.hwui.use_gpu_pixel_buffers=1

# Reduce Texture
ro.hwui.texture_cache_flushrate=0.4
ro.texture_atlas_cache_override=0.25
ro.texture_atlas_cache_entry_override=0.034
ro.texture_atlas_map_pool_override=0.15

# Disable 4xmsaa
debug.egl.disable_msaa=true
debug.egl.disable_msaa=1
camera.debug.logfile=0

# Memory properties
ro.vendor.qti.sys.fw.bservice_enable=true

# More RAM
persist.service.pcsync.enable=0
persist.service.lgospd.enable=0

# Allow purge of assets to free more ram
persist.sys.purgeable_assets=1

# Property to enable app trigger
ro.vendor.at_library=libqti-at.so
persist.vendor.qti.games.gt.prof=1

# Memory Optimization
logcat.live=disable
ro.config.htc.nocheckin=1
debugtool.anrhistory=0
profiler.debugmonitor=0
profiler.launch=0
profiler.hung.dumpdobugreport=0
ro.sys.fw.bservice_enable=true
ro.sys.fw.bservice_limit=128
ro.sys.fw.bservice_age=10000
ro.sys.fw.bg_apps_limit=256
ro.vendor.qti.sys.fw.bservice_enable=true
ro.vendor.qti.sys.fw.bservice_limit=128
ro.vendor.qti.sys.fw.bservice_age=10000
ro.vendor.qti.sys.fw.bg_apps_limit=256
debug.systemui.latency_tracking=false
debug.trace_resource_preload=false
debug.track_amkill=false
debug.perf_event_max_sample_rate=0
debug.perf_cpu_time_max_percent=0
debug.perf_event_mlock_kb=0
persist.traced.enable=0
persist.sys.logkit.ctrl_enable=0
persist.sys.logkit.disable_log=1
debug.hwui.trace_gpu_resources=false
debug.sf.enable_transaction_tracing=0
debug.atrace.tags.enableflags=0

#GMS DOZE
doze.display.supported=true
doze.pulse.notifications=true
doze.use.accelerometer=0
doze.pickup.vibration.threshold=2000
doze.pulse.brightness=5
doze.pulse.delay.in=200
doze.pulse.duration.in=1000
doze.pulse.duration.out=1000
doze.pulse.duration.visible=3000
doze.pulse.proxcheck=0
doze.pulse.schedule=1s,10s,30s,60s,120s,180s
doze.pulse.schedule.resets=3
doze.pulse.sigmotion=0
doze.shake.acc.threshold=10
doze.vibrate.sigmotion=0
debug.doze.component=0
ro.am.reschedule_service=true
hwui.print_config=choice
lmk.autocalc=true

#tweak
persist.sys.NV_FPSLIMIT=90
persist.sys.NV_POWERMODE=1
persist.sys.NV_PROFVER=15
persist.sys.NV_STEREOCTRL=0
persist.sys.NV_STEREOSEPCHG=0
persist.sys.NV_STEREOSEP=20
persist.sys.purgeable_assets=1

# SkiaGL Render
debug.hwui.renderer=skiagl
debug.renderengine.backend=skiaglthreaded
debug.renderengine.graphite=true
ro.hwui.hardware.skiaglthreaded=true
ro.hwui.use_skiaglthreaded=true
ro.ui.pipeline=skiaglthreaded
persist.service.gfx.renderthread=1

#Skia tracing disabler
debug.hwui.render_dirty_regions=false
debug.hwui.pipeline=false
debug.hwui.overdraw=false
debug.hwui.skia_atrace_enabled=false
debug.stagefright.renderengine.backend=threaded
renderthread.skia.reduceopstasksplitting=true

#Improve sliding response
windowsmgr.max_events_per_sec=90
view.scroll_friction=0
ro.min_pointer_dur=8
touch.deviceType=touchScreen
debug.graphics.game_default_frame_rate.disabled=1

# Fast App Launch
persist.device_config.runtime_native.usap_pool_enabled=true
persist.zygote.preload_threads=3
ro.zygote.disable_gl_preload=false
ro.zygote.preload.enable=0
ro.zygote.preload.disable=1

#Improve global touch screen response
debug.egl.hw=1
video.accelerate.hw=1

# Disable Unnecessary 
ro.hwui.disable_scissor_opt=false
ro.zygote.disable_gl_preload=1

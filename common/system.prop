# QuickPower
ro.config.hw_quickpoweron=true

# GPU & HWUI
hw3d.force=1
persist.sys.ui.hw=1
persist.service.gfx.gpu_rendering_priority=1
ro.config.enable.hw_accel=true
video.accelerate.hw=1
debug.hwui.app_memory_policy=balanced
debug.hwui.optimized_texture_upload=true
debug.hwui.use_gpu_pixel_buffers=1
ro.hwui.expensive_rendering_threshold=12000

# Texture Cache
ro.hwui.texture_cache_flushrate=0.6
ro.texture_atlas_cache_override=0.25

# Disable MSAA
debug.egl.disable_msaa=true

# Memory Optimization
ro.vendor.qti.sys.fw.bservice_enable=true
ro.vendor.qti.sys.fw.bservice_limit=256
ro.vendor.qti.sys.fw.bservice_age=15000
ro.vendor.qti.sys.fw.bg_apps_limit=256
persist.sys.purgeable_assets=1

# Doze
doze.display.supported=true
doze.pulse.notifications=true
doze.pulse.delay.in=500
doze.pulse.duration.in=1000
doze.pulse.duration.out=1000
doze.pulse.duration.visible=3000

# Input & Touch
windowsmgr.max_events_per_sec=100
view.scroll_friction=0.008
ro.max.fling_velocity=20000

# Zygote & Fast Launch
persist.device_config.runtime_native.usap_pool_enabled=true
persist.zygote.preload_threads=4
ro.zygote.use_large_pages=true

# Rendering (SkiaGL)
debug.hwui.renderer=skiagl
debug.renderengine.backend=skiaglthreaded
ro.hwui.use_skiaglthreaded=true

# Thermal & Battery
persist.sys.thermal.enable=true
dalvik.vm.usejit=true
dalvik.vm.dex2oat-filter=speed

# Network
net.dns1=8.8.8.8
net.dns2=8.8.4.4
